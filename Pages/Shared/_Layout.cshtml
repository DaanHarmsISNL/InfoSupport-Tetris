<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - infosupport_tetris</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/tokens/brand-primitives.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tokens/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tokens/bootstrap-bridge.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tokens/base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/infosupport_tetris.styles.css" asp-append-version="true" />
</head>
<body>
    @* docs/specs/012-landing-page.md DR-246: no navigation bar, no footer link list anywhere in
       the product -- it is one game, one board and one front door. Pages that need landmark
       regions of their own (the landing page) define them directly rather than relying on this
       wrapper's <main>. *@
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
