@page
@model IndexModel
@{
    // docs/specs/012-landing-page.md: the landing page owns its own landmark structure (banner /
    // main / contentinfo, §5.1) rather than the shared _Layout's generic <main>, so Layout is
    // suppressed here and the page renders a complete, self-contained document instead.
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @* FR-021/DR-254: identifies the product out of context (tab strip, bookmark, link preview),
       distinct from the h1 below, which is just "Tetris". *@
    <title>Info Support Tetris</title>
    <link rel="stylesheet" href="~/css/tokens/brand-primitives.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tokens/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tokens/base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />
</head>
<body>
    @* 5.1 Brand region: banner landmark, skippable, visually part of the hero band (shared
       --brand-deep background) but a separate landmark for assistive technology. *@
    <header class="landing-brand" role="banner">
        @* DR-238/DR-239: no mark asset exists in this repo, so a styled text lockup stands in for
           it, carrying the text alternative "Info Support" via role="img" + aria-label -- this
           survives a failed image load trivially, since there is no image to fail (SC-018). *@
        <div class="landing-mark" role="img" aria-label="Info Support">Info Support</div>
    </header>

    @* 5.1 Hero region: main landmark, carries messages 1-3 (DR-232). *@
    <main class="landing-hero" role="main">
        <h1 class="landing-h1">Tetris</h1>
        <p class="landing-lead">
            Ten columns, five minutes, one all-time leaderboard. No sign-up, no settings &mdash; one key and
            you&rsquo;re playing.
        </p>

        @* DR-229/FR-025: a plain HTML form posting straight to the game's own Start handler -- no
           intermediate Ready screen, no JS dependency, operable the instant the markup parses.
           DR-247: autofocus is a native HTML attribute, so initial focus lands here with no
           script and without scrolling the page. DR-250: the keystroke that activates this (Enter
           or Space) is consumed by the browser's native form submission and is never delivered to
           the new GameSession as an input command -- nothing here listens for it as one. *@
        <form method="post" asp-page="/Game" asp-page-handler="Start" class="landing-primary-form">
            <button type="submit" class="landing-play-button" autofocus>
                Play
                @* DR-251: decorative only, excluded from the accessible name via aria-hidden. *@
                <span class="landing-key-hint" aria-hidden="true">Enter</span>
            </button>
        </form>

        @* 5.1 "Ways in" -- within the main landmark, --surface background, separated from the
           hero by --border-subtle. Carries message 4. *@
        <div class="landing-ways-in">
            @* FR-015/DR-243: no precondition, resolves to 010's stable shareable address. *@
            <a class="landing-leaderboard-link" asp-page="/Leaderboard">View the leaderboard</a>

            @* FR-017/DR-244: story 014 doesn't exist yet -- this is a placeholder entry point into
               the game page, never auto-opened, ranked third and ranked below the leaderboard. *@
            <a class="landing-howto-link" asp-page="/Game" asp-fragment="controls">How to play</a>
        </div>
    </main>

    @* 5.1 Colophon: optional, unlinked, single line (DR-246). *@
    <footer class="landing-colophon" role="contentinfo">
        <p>An Info Support product.</p>
    </footer>
</body>
</html>
