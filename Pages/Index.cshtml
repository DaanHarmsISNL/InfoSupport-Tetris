@page
@model IndexModel
@using infosupport_tetris.Domain
@{
    ViewData["Title"] = "Tetris";
}

<div class="text-center">
    <h1 class="display-4">Tetris</h1>

    @{
        // docs/specs/004-next-piece-preview.md: the preview panel is rendered in every branch
        // below (Ready, Playing, GameOver) with the same markup, so DR-57's fixed area never
        // resizes or moves as Status changes.
        var preview = Model.Preview;
    }
    @if (Model.Session is null || Model.Session.Status == GameStatus.Ready)
    {
        <p>Take five. One click, no sign-up.</p>
        <form method="post" asp-page-handler="Start">
            <button type="submit" class="btn btn-primary btn-lg">Start game</button>
        </form>

        @* docs/specs/010-view-leaderboard.md FR-014/DR-193: reachable from the landing area with
           no precondition -- no finished run, no submitted score, no prior play. *@
        <p><a asp-page="/Leaderboard">View leaderboard</a></p>

        @await Html.PartialAsync("_HoldDisplay", Model.Hold)
        @await Html.PartialAsync("_NextPiecePreview", preview)
    }
    else
    {
        @* US-003 (DR-14/DR-26): no JS framework exists yet, so gravity is driven server-side by
           having the page auto-refresh; each GET recomputes GameSession.Tick from the real
           elapsed wall-clock time (see IndexModel.OnGet). Simple and sufficient to make gravity
           visible; the spec-tested logic lives entirely in GameSession.Tick, not here. *@
        @if (Model.Session.Status == GameStatus.Playing)
        {
            <meta http-equiv="refresh" content="0.25">
        }
        <p>
            Status: @Model.Session.Status &nbsp;|&nbsp;
            Level: @Model.Session.Level &nbsp;|&nbsp;
            Score: @Model.Session.Score &nbsp;|&nbsp;
            Lines: @Model.Session.LinesCleared
        </p>

        @* docs/specs/008-game-over.md FR-004/FR-005/FR-007 (US-001/US-002/US-003): an unmistakable,
           immediate game-over indication together with the frozen final summary -- score, lines
           cleared, level and pieces spawned, exactly as frozen (DR-104) -- and the reason the run
           ended (FR-008/FR-009). No animation, countdown or dismissal step (FR-004). *@
        @if (Model.Session.Status == GameStatus.GameOver && Model.Session.CompletedRun is { } run)
        {
            <div role="alert" aria-live="assertive" class="tetris-game-over">
                <p><strong>Game Over</strong> &mdash; @(run.TopOutReason == TopOutReason.BlockOut ? "no room left to spawn" : "locked out above the field")</p>
                <p>
                    Final score: @run.FinalScore &nbsp;|&nbsp;
                    Lines cleared: @run.LinesCleared &nbsp;|&nbsp;
                    Level reached: @run.FinalLevel &nbsp;|&nbsp;
                    Pieces spawned: @run.PiecesSpawned
                </p>
            </div>

            @* docs/specs/009-submit-score.md FR-001/FR-012: the name field + submit + skip, reachable
               from the keyboard alone and deliberately NOT auto-focused (open question 3, so 008's
               `R` play-again binding above is never swallowed as typed text). The actual submission
               state machine (SubmissionStatus, §5.1) runs client-side in the script below, since no
               JS framework/SPA exists in this project (009 §9.2/FR-016..FR-020). *@
            <div class="tetris-score-submission" data-run-id="@run.RunId" data-score="@run.FinalScore"
                 data-lines-cleared="@run.LinesCleared" data-level="@run.FinalLevel">
                <label for="player-name-input">Your name</label>
                <input type="text" id="player-name-input" maxlength="20" autocomplete="off"
                       aria-describedby="submission-status" />
                <button type="button" id="submit-score-button">Submit score</button>
                <button type="button" id="skip-score-button">Skip</button>
                <p id="submission-status" role="status" aria-live="polite"></p>
            </div>

            @* docs/specs/010-view-leaderboard.md FR-014/SC-019: reachable from the game-over state
               with no precondition -- following it needs no submitted score (DR-192 is honoured by
               the store itself, since the entry was already written before this link is followed). *@
            <p><a asp-page="/Leaderboard">View leaderboard</a></p>
        }

        @* FR-003/FR-004/DR-01: only the 20 visible rows x 10 columns are drawn; the 20 buffer
           rows above them are never rendered, so a piece occupying only buffer rows is invisible.
           US-002: the active piece's cells are colour-coded by TetrominoType (DR-24) via
           Model.ActivePieceVisibleCells, which already excludes buffer-row cells. *@
        <div class="tetris-layout">
            <div class="tetris-playfield" role="img" aria-label="Tetris playfield">
                @for (var visibleRow = 0; visibleRow < Playfield.VisibleRowCount; visibleRow++)
                {
                    <div class="tetris-row">
                        @for (var column = 0; column < Playfield.ColumnCount; column++)
                        {
                            var cell = Model.Session.Playfield.GetVisibleCell(visibleRow, column);
                            if (Model.ActivePieceVisibleCells.TryGetValue((visibleRow, column), out var activeColour))
                            {
                                <div class="tetris-cell occupied active-piece" style="background-color:@activeColour;"></div>
                            }
                            else
                            {
                                var cssClass = cell.IsOccupied ? $"tetris-cell occupied type-{cell.Occupant}" : "tetris-cell";
                                <div class="@cssClass"></div>
                            }
                        }
                    </div>
                }
            </div>

            <div class="tetris-side-panel">
                @await Html.PartialAsync("_HoldDisplay", Model.Hold)
                @await Html.PartialAsync("_NextPiecePreview", preview)
            </div>
        </div>

        @* docs/specs/008-game-over.md FR-011/FR-018: "play again" is the same action as 001
           FR-005's "New game" (DR-105/DR-23), surfaced here with its game-over label. FR-012/FR-013:
           reachable from the keyboard alone (see the `R` binding below), one action, no confirm. *@
        <form method="post" asp-page-handler="NewGame" id="new-game-form" class="mt-3">
            <button type="submit" class="btn btn-secondary">
                @(Model.Session.Status == GameStatus.GameOver ? "Play again (R)" : "New game")
            </button>
        </form>

        @if (Model.Session.Status == GameStatus.GameOver)
        {
            <script>
                // docs/specs/008-game-over.md FR-012/open question 2: `R` triggers play again from
                // the keyboard alone. `Enter` is deliberately left unbound here for story 009.
                (function () {
                    document.addEventListener('keydown', function (event) {
                        if (event.repeat) {
                            return;
                        }
                        if (event.code !== 'KeyR') {
                            return;
                        }
                        var form = document.getElementById('new-game-form');
                        if (form) {
                            event.preventDefault();
                            form.submit();
                        }
                    });
                })();
            </script>

            <script>
                // docs/specs/009-submit-score.md: the ScoreSubmission state machine (§5.1) for the
                // one finished run on this page. Entirely client-side -- there is no JS framework in
                // this project, so this plain script owns Unsubmitted/Submitting/Submitted/Failed/
                // Declined (§5.4) for the lifetime of this page load, exactly as long as the
                // game-over state is shown (DR-106).
                (function () {
                    var container = document.querySelector('.tetris-score-submission');
                    if (!container) {
                        return;
                    }

                    var runId = container.dataset.runId;
                    var score = Number(container.dataset.score);
                    var linesCleared = Number(container.dataset.linesCleared);
                    var level = Number(container.dataset.level);

                    var nameInput = document.getElementById('player-name-input');
                    var submitButton = document.getElementById('submit-score-button');
                    var skipButton = document.getElementById('skip-score-button');
                    var statusEl = document.getElementById('submission-status');

                    // DR-115/DR-117/DR-125: closed over this run only -- Submitted/Declined are
                    // terminal and a submit while Submitting is ignored outright, never queued.
                    var status = 'Unsubmitted';

                    function setStatus(message) {
                        statusEl.textContent = message;
                    }

                    function submit() {
                        // DR-125/FR-020: ignore a submit activation while one is already in flight.
                        if (status === 'Submitting' || status === 'Submitted') {
                            return;
                        }

                        status = 'Submitting';
                        setStatus('Submitting...');

                        var controller = new AbortController();
                        // DR-128/FR-017: abandon after 10 seconds and report it as failed.
                        var timeoutId = setTimeout(function () { controller.abort(); }, 10000);

                        fetch('?handler=SubmitScore', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            signal: controller.signal,
                            body: JSON.stringify({
                                runId: runId,
                                playerName: nameInput.value,
                                score: score,
                                linesCleared: linesCleared,
                                level: level
                            })
                        })
                            .then(function (response) {
                                clearTimeout(timeoutId);
                                if (!response.ok) {
                                    throw new Error('server error');
                                }
                                return response.json();
                            })
                            .then(function (result) {
                                if (result.success) {
                                    // DR-119/DR-126: the server's storedName is authoritative, never
                                    // the field contents -- a retry after a lost response may return
                                    // a name the player has since edited (EC-4).
                                    status = 'Submitted';
                                    nameInput.value = result.playerName;
                                    nameInput.disabled = true;
                                    submitButton.disabled = true;
                                    setStatus('Submitted! Your score is on the board.');
                                } else {
                                    status = 'Failed';
                                    setStatus(result.failureMessage || 'The submission was refused.');
                                }
                            })
                            .catch(function (error) {
                                clearTimeout(timeoutId);
                                status = 'Failed';
                                // FR-018/DR-127: the typed name and the run stay intact; a retry is available.
                                setStatus(error.name === 'AbortError'
                                    ? 'The submission timed out. You can try again.'
                                    : 'The submission failed. You can try again.');
                            });
                    }

                    submitButton.addEventListener('click', submit);

                    // FR-012: Enter submits while the name field has focus.
                    nameInput.addEventListener('keydown', function (event) {
                        if (event.code === 'Enter' || event.key === 'Enter') {
                            event.preventDefault();
                            submit();
                        }
                    });

                    // DR-116/DR-117/FR-013/FR-015: skip discards the run silently, nothing sent.
                    skipButton.addEventListener('click', function () {
                        status = 'Declined';
                        nameInput.disabled = true;
                        submitButton.disabled = true;
                        skipButton.disabled = true;
                        setStatus('Skipped.');
                    });

                    // FR-014/DR-129: play again is never blocked by submission state. The "R" and
                    // click handlers for #new-game-form are entirely independent of this script.
                })();
            </script>
        }

        @* Spec 003 (hard drop): Space is bound to this form alone (DR-49). There is no JS
           framework in this project, so the gravity/lock loop is driven by the meta-refresh above
           and hard drop is driven by this dedicated POST, submitted by the edge-triggered keydown
           listener below rather than by the player clicking a button. *@
        @if (Model.Session.Status == GameStatus.Playing)
        {
            <form method="post" asp-page-handler="HardDrop" id="hard-drop-form" class="d-none"></form>
        }

        @* Spec 002 §5.3 KeyBinding/DR-29/DR-42: client-side key capture. The server (GameSession)
           is the sole authority on whether an action is legal (DR-28, DR-30, DR-35); this script
           only translates DOM key events into InputCommand posts and suppresses the browser's
           default action for bound keys while playing. Per DR-31/DR-32 it sends press/release
           events only — DAS/ARR repeat *timing* is InputState/GameSession's job (see
           GameSession.Tick), driven forward by the page's own auto-refresh. *@
        @if (Model.Session.Status == GameStatus.Playing)
        {
            <script>
                (function () {
                    const bindings = {
                        ArrowLeft: 'MoveLeft',
                        ArrowRight: 'MoveRight',
                        ArrowDown: 'SoftDropStart',
                        ArrowUp: 'RotateClockwise',
                        KeyX: 'RotateClockwise',
                        KeyZ: 'RotateCounterClockwise',
                        ControlLeft: 'RotateCounterClockwise',
                        ControlRight: 'RotateCounterClockwise',
                        // docs/specs/005-hold-piece.md DR-63: `C` or either `Shift`, key-down edge only.
                        KeyC: 'Hold',
                        ShiftLeft: 'Hold',
                        ShiftRight: 'Hold'
                    };

                    const held = new Set();

                    function post(handler, command) {
                        fetch('?handler=' + handler + '&command=' + command, { method: 'POST' });
                    }

                    document.addEventListener('keydown', function (e) {
                        const command = bindings[e.code];
                        if (!command) {
                            return;
                        }

                        e.preventDefault(); // DR-42: never scroll/page-down on a bound key.

                        if (e.repeat) {
                            return; // DR-31/DR-34: OS key-repeat is ignored; the game times its own.
                        }

                        held.add(e.code);
                        post('Input', command);
                    });

                    document.addEventListener('keyup', function (e) {
                        const command = bindings[e.code];
                        if (!command) {
                            return;
                        }

                        held.delete(e.code);

                        if (command === 'MoveLeft' || command === 'MoveRight') {
                            post('Release', command);
                        } else if (command === 'SoftDropStart') {
                            post('Release', 'SoftDropEnd');
                        }
                    });

                    // EC-7/EC-8: losing focus releases everything, so nothing auto-repeats forever.
                    window.addEventListener('blur', function () {
                        if (held.has('ArrowLeft')) { post('Release', 'MoveLeft'); }
                        if (held.has('ArrowRight')) { post('Release', 'MoveRight'); }
                        if (held.has('ArrowDown')) { post('Release', 'SoftDropEnd'); }
                        held.clear();
                    });
                })();
            </script>
        }
    }
</div>

@section Scripts {
    @if (Model.Session is { Status: GameStatus.Playing })
    {
        <script>
            // Spec 003 -- DR-47 (edge trigger) / DR-49 (Space only) / DR-51 (arming scope).
            // `armed` tracks the physical key for the lifetime of this page load: cleared on
            // key-down, set again only by key-up or by the window losing focus (treated as a
            // key-up per DR-51/FR-011). Every tick of the game loop (gravity, lock, spawn,
            // hard drop itself) reloads this page via the meta-refresh or a form POST, which
            // reinitialises `armed = true` on a fresh script context -- so a key held across a
            // lock/spawn/game-over boundary never produces a second hard drop (DR-51), because no
            // new keydown event is dispatched for a key that never went up.
            (function () {
                var armed = true;

                function isTypingTarget(target) {
                    return !!target && (target.tagName === 'INPUT' || target.tagName === 'TEXTAREA' || target.isContentEditable);
                }

                document.addEventListener('keydown', function (event) {
                    if (event.code !== 'Space' && event.key !== ' ') {
                        return;
                    }

                    // EC-10: don't swallow Space typed into a text field (e.g. story 009's name entry).
                    if (isTypingTarget(event.target)) {
                        return;
                    }

                    // DR-47: ignore OS autorepeat key-downs and any key-down while already disarmed.
                    if (event.repeat || !armed) {
                        event.preventDefault();
                        return;
                    }

                    armed = false;
                    event.preventDefault();

                    var form = document.getElementById('hard-drop-form');
                    if (form) {
                        form.submit();
                    }
                });

                document.addEventListener('keyup', function (event) {
                    if (event.code === 'Space' || event.key === ' ') {
                        armed = true; // DR-51: release re-arms the trigger.
                    }
                });

                window.addEventListener('blur', function () {
                    armed = true; // DR-51/FR-011: a missed release must not disable hard drop permanently.
                });
            })();
        </script>
    }
}

<style>
    .tetris-layout {
        display: inline-flex;
        align-items: flex-start;
        gap: 16px;
    }

    .tetris-playfield {
        display: inline-block;
        border: 2px solid #333;
        background: #111;
    }

    .tetris-row {
        display: flex;
    }

    .tetris-cell {
        width: 24px;
        height: 24px;
        box-sizing: border-box;
        border: 1px solid #222;
        background: #111;
    }

    .tetris-cell.occupied {
        background: #888;
    }

    /* docs/specs/004-next-piece-preview.md DR-57/NFR-003: the side panel and the preview grid
       within it are a fixed size regardless of Status or the previewed type, so neither the
       panel nor the playfield shifts as the preview changes or empties. */
    .tetris-side-panel {
        width: 140px;
        text-align: left;
    }

    .tetris-preview-caption {
        font-weight: bold;
        margin-bottom: 4px;
    }

    .tetris-preview-grid {
        position: relative;
        /* NFR-002: preview cells are >= 60% of the 24px playfield cell (here: the full 24px). */
        width: calc(4 * 24px);
        height: calc(2 * 24px);
        border: 2px solid #333;
        background: #111;
        box-sizing: border-box;
    }

    .tetris-preview-cell {
        position: absolute;
        width: 24px;
        height: 24px;
        box-sizing: border-box;
        border: 1px solid #222;
    }

    /* docs/specs/005-hold-piece.md DR-73: same fixed 4x2 footprint as the preview grid, so
       neither resizes or reflows as the hold slot fills, empties or swaps. */
    .tetris-hold-caption {
        font-weight: bold;
        margin-bottom: 4px;
    }

    .tetris-hold-grid {
        position: relative;
        width: calc(4 * 24px);
        height: calc(2 * 24px);
        border: 2px solid #333;
        background: #111;
        box-sizing: border-box;
        margin-bottom: 12px;
    }

    .tetris-hold-cell {
        position: absolute;
        width: 24px;
        height: 24px;
        box-sizing: border-box;
        border: 1px solid #222;
    }

    /* NFR-003: unavailable is conveyed by >= 2 independent cues -- reduced opacity *and* a
       desaturated/dashed, non-colour cue -- never colour or opacity alone. */
    .tetris-hold-grid.unavailable {
        opacity: 0.4;
        border-style: dashed;
        filter: grayscale(60%);
    }
</style>
