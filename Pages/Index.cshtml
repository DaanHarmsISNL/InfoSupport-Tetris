@page
@model IndexModel
@using infosupport_tetris.Domain
@{
    ViewData["Title"] = "Tetris";
}

<div class="text-center">
    <h1 class="display-4">Tetris</h1>

    @if (Model.Session is null || Model.Session.Status == GameStatus.Ready)
    {
        <p>Take five. One click, no sign-up.</p>
        <form method="post" asp-page-handler="Start">
            <button type="submit" class="btn btn-primary btn-lg">Start game</button>
        </form>
    }
    else
    {
        @* US-003 (DR-14/DR-26): no JS framework exists yet, so gravity is driven server-side by
           having the page auto-refresh; each GET recomputes GameSession.Tick from the real
           elapsed wall-clock time (see IndexModel.OnGet). Simple and sufficient to make gravity
           visible; the spec-tested logic lives entirely in GameSession.Tick, not here. *@
        @if (Model.Session.Status == GameStatus.Playing)
        {
            <meta http-equiv="refresh" content="0.25">
        }
        <p>
            Status: @Model.Session.Status &nbsp;|&nbsp;
            Level: @Model.Session.Level &nbsp;|&nbsp;
            Score: @Model.Session.Score
        </p>

        @* US-004/DR-21/DR-22: minimal acknowledgement that the session ended (block out or lock
           out). The GameOver presentation itself (final score, etc.) is story 008's concern. *@
        @if (Model.Session.Status == GameStatus.GameOver)
        {
            <p><strong>Game Over</strong></p>
        }

        @* FR-003/FR-004/DR-01: only the 20 visible rows x 10 columns are drawn; the 20 buffer
           rows above them are never rendered, so a piece occupying only buffer rows is invisible.
           US-002: the active piece's cells are colour-coded by TetrominoType (DR-24) via
           Model.ActivePieceVisibleCells, which already excludes buffer-row cells. *@
        <div class="tetris-playfield" role="img" aria-label="Tetris playfield">
            @for (var visibleRow = 0; visibleRow < Playfield.VisibleRowCount; visibleRow++)
            {
                <div class="tetris-row">
                    @for (var column = 0; column < Playfield.ColumnCount; column++)
                    {
                        var cell = Model.Session.Playfield.GetVisibleCell(visibleRow, column);
                        if (Model.ActivePieceVisibleCells.TryGetValue((visibleRow, column), out var activeColour))
                        {
                            <div class="tetris-cell occupied active-piece" style="background-color:@activeColour;"></div>
                        }
                        else
                        {
                            var cssClass = cell.IsOccupied ? $"tetris-cell occupied type-{cell.Occupant}" : "tetris-cell";
                            <div class="@cssClass"></div>
                        }
                    }
                </div>
            }
        </div>

        <form method="post" asp-page-handler="NewGame" class="mt-3">
            <button type="submit" class="btn btn-secondary">New game</button>
        </form>

        @* Spec 003 (hard drop): Space is bound to this form alone (DR-49). There is no JS
           framework in this project, so the gravity/lock loop is driven by the meta-refresh above
           and hard drop is driven by this dedicated POST, submitted by the edge-triggered keydown
           listener below rather than by the player clicking a button. *@
        @if (Model.Session.Status == GameStatus.Playing)
        {
            <form method="post" asp-page-handler="HardDrop" id="hard-drop-form" class="d-none"></form>
        }
    }
</div>

@section Scripts {
    @if (Model.Session is { Status: GameStatus.Playing })
    {
        <script>
            // Spec 003 -- DR-47 (edge trigger) / DR-49 (Space only) / DR-51 (arming scope).
            // `armed` tracks the physical key for the lifetime of this page load: cleared on
            // key-down, set again only by key-up or by the window losing focus (treated as a
            // key-up per DR-51/FR-011). Every tick of the game loop (gravity, lock, spawn,
            // hard drop itself) reloads this page via the meta-refresh or a form POST, which
            // reinitialises `armed = true` on a fresh script context -- so a key held across a
            // lock/spawn/game-over boundary never produces a second hard drop (DR-51), because no
            // new keydown event is dispatched for a key that never went up.
            (function () {
                var armed = true;

                function isTypingTarget(target) {
                    return !!target && (target.tagName === 'INPUT' || target.tagName === 'TEXTAREA' || target.isContentEditable);
                }

                document.addEventListener('keydown', function (event) {
                    if (event.code !== 'Space' && event.key !== ' ') {
                        return;
                    }

                    // EC-10: don't swallow Space typed into a text field (e.g. story 009's name entry).
                    if (isTypingTarget(event.target)) {
                        return;
                    }

                    // DR-47: ignore OS autorepeat key-downs and any key-down while already disarmed.
                    if (event.repeat || !armed) {
                        event.preventDefault();
                        return;
                    }

                    armed = false;
                    event.preventDefault();

                    var form = document.getElementById('hard-drop-form');
                    if (form) {
                        form.submit();
                    }
                });

                document.addEventListener('keyup', function (event) {
                    if (event.code === 'Space' || event.key === ' ') {
                        armed = true; // DR-51: release re-arms the trigger.
                    }
                });

                window.addEventListener('blur', function () {
                    armed = true; // DR-51/FR-011: a missed release must not disable hard drop permanently.
                });
            })();
        </script>
    }
}

<style>
    .tetris-playfield {
        display: inline-block;
        border: 2px solid #333;
        background: #111;
    }

    .tetris-row {
        display: flex;
    }

    .tetris-cell {
        width: 24px;
        height: 24px;
        box-sizing: border-box;
        border: 1px solid #222;
        background: #111;
    }

    .tetris-cell.occupied {
        background: #888;
    }
</style>
